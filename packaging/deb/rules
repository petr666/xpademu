#!/usr/bin/make -f
%:
	dh $@ --with python3

execute_after_dh_auto_install:
	install -d debian/xpademu/etc/xpademu.d
	install -m 0644 examples/thrustmaster_score_a.json debian/xpademu/etc/xpademu.d/thrustmaster_score_a.json.example
	install -m 0644 examples/xiaomi_gamepad.json debian/xpademu/etc/xpademu.d/xiaomi_gamepad.json.example
